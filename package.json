{
  "name": "@useinvio/nfse-sdk",
  "version": "3.2.0",
  "description": "TypeScript SDK for Brazil's national NFS-e: JSON to DPS/XML, XMLDSIG, GZip/Base64, mTLS and SEFIN errors.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./mcp": {
      "types": "./dist/mcpServer.d.ts",
      "import": "./dist/mcpServer.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*.d.ts",
    "dist/*.js",
    "dist/*.js.map",
    "dist/schemas/**/*.xsd",
    "docs/**/*.md",
    "examples/*.ts",
    "examples/README.md",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "JSON_MAPPING.md",
    "llms.txt",
    "LICENSE",
    "schemas/**/*.xsd"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "typecheck:examples": "tsc -p tsconfig.examples.json"
  },
  "keywords": [
    "nfse",
    "nfs-e",
    "nfs-e-nacional",
    "nota-fiscal",
    "nota-fiscal-servico",
    "dps",
    "sefin",
    "sped",
    "xml-dsig",
    "xmldsig",
    "mtls",
    "typescript",
    "brazil",
    "erp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/useinvio/nfse-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/useinvio/nfse-sdk/issues"
  },
  "homepage": "https://github.com/useinvio/nfse-sdk#readme",
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.15",
    "libxml2-wasm": "^0.7.2",
    "node-forge": "^1.4.3",
    "xml-crypto": "^6.4.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^22.13.14",
    "@types/node-forge": "^1.3.11",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "nfse-mcp": "dist/mcpCli.js"
  }
}
